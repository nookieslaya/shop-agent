{
  "name": "shop-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit:nortberg": "node --import tsx src/cli/audit-nortberg.ts",
    "sync:nortberg": "node --import tsx src/cli/sync-nortberg.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run build && npm run test"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.3.3",
    "p-limit": "^7.2.0",
    "postgres": "^3.4.9",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=22"
  }
}
